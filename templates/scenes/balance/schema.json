{
  "id": "balance",
  "family": "balance",
  "variants": ["scale-tilt", "tug", "seesaw"],
  "signatures": ["scale-tilt"],
  "zone": { "scale-tilt": "split-50", "tug": "split-50", "seesaw": "hero-center" },
  "slots": {
    "type": "object",
    "required": ["left", "right", "winner"],
    "additionalProperties": false,
    "properties": {
      "left": {
        "type": "object", "required": ["label", "items"], "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 18 },
          "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "items": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 22 } }
        }
      },
      "right": {
        "type": "object", "required": ["label", "items"], "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 18 },
          "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "items": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 22 } }
        }
      },
      "winner": { "type": "string", "enum": ["left", "right", "even"] }
    }
  },
  "reveals": {
    "left": { "default": "kw", "range": false },
    "left.items.*": { "default": "kw", "range": false },
    "right": { "default": "kw", "range": false },
    "right.items.*": { "default": "kw", "range": false },
    "tip": { "default": "spread", "range": false }
  },
  "duration": { "min": 3.5, "max": 10 },
  "fit": { "minItems": 2, "maxItems": 8, "cue": "cân nhắc|cán cân|đánh đổi|lợi và hại|ưu và nhược|ưu điểm|nhược điểm|được và mất|hai mặt" }
}
