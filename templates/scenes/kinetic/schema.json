{
  "id": "kinetic",
  "family": "kinetic",
  "variants": ["center-punch", "stack-words"],
  "zone": { "center-punch": "hero-center", "stack-words": "split-60-40" },
  "slots": {
    "type": "object",
    "required": ["words"],
    "additionalProperties": false,
    "properties": {
      "words": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 18 } },
      "sub": { "type": "string", "maxLength": 48 }
    }
  },
  "reveals": {
    "words.*": { "default": "kw", "range": false },
    "sub": { "default": "spread", "range": false }
  },
  "duration": { "min": 1.5, "max": 10 }
}
