{
  "id": "pictogram-scene",
  "family": "metaphor",
  "variants": ["triptych", "scene-row", "transform"],
  "signatures": ["transform"],
  "zone": { "triptych": "triptych", "scene-row": "lower-third", "transform": "split-50" },
  "slots": {
    "type": "object",
    "required": ["pictos"],
    "additionalProperties": false,
    "properties": {
      "pictos": {
        "type": "array", "minItems": 1, "maxItems": 5,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      },
      "labels": {
        "type": "array", "minItems": 0, "maxItems": 5,
        "items": { "type": "string", "minLength": 1, "maxLength": 16 }
      },
      "badge": { "type": "string", "minLength": 1, "maxLength": 24 }
    }
  },
  "reveals": {
    "pictos.*": { "default": "kw", "range": false },
    "badge": { "default": "spread", "range": false }
  },
  "duration": { "min": 2.5, "max": 10 }
}
