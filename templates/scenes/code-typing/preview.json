      "# Vòng lặp chính: lập kế hoạch rồi gọi công cụ đúng",
      "def run(task, max_steps=12, timeout=30, lang='vi'):",
      "    plan = llm.plan(task, lang='vi', depth=3, n=2)",
      "    for index, step in enumerate(plan.steps, 1):",
      "        result = tools.call(step, timeout=timeout)",
      "        memory.save(step.name, result, ttl=3600)",
      "        if index >= max_steps: break  # dừng sớm",
      "    return memory.summary(style='ngắn gọn, dễ hiểu')"
    ],
