{
  "id": "code-typing",
  "family": "code-typing",
  "variants": ["editor", "palette"],
  "signatures": ["editor"],
  "zone": { "editor": "hero-center", "palette": "hero-center" },
  "slots": {
    "type": "object",
    "required": ["file", "lines"],
    "additionalProperties": false,
    "properties": {
      "file": { "type": "string", "minLength": 1, "maxLength": 32, "description": "editor: the file name; palette: the mode chip (e.g. Claude Code)" },
      "lines": {
        "type": "array", "minItems": 1, "maxItems": 8,
        "description": "the real command, prompt or code, one string per line, typed in order",
        "items": { "type": "string", "maxLength": 52 }
      },
      "note": { "type": "string", "maxLength": 48 }
    }
  },
  "reveals": {
    "lines": { "default": "kw", "range": true, "code": true },
    "note": { "default": "spread", "range": false, "after": "lines" }
  },
  "duration": { "min": 3, "max": 10 }
}
