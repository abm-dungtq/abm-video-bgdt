{
  "id": "flap-board",
  "family": "flap-board",
  "variants": ["board", "departures"],
  "signatures": ["board"],
  "zone": { "board": "hero-center", "departures": "strip-top" },
  "slots": {
    "type": "object",
    "required": ["lines"],
    "additionalProperties": false,
    "properties": {
      "kicker": { "type": "string", "maxLength": 28 },
      "lines": {
        "type": "array", "minItems": 1, "maxItems": 3,
        "description": "one board row each, shown in capitals: a name, a version, a date",
        "items": { "type": "string", "minLength": 1, "maxLength": 14 }
      },
      "note": { "type": "string", "maxLength": 48 }
    }
  },
  "reveals": {
    "kicker": { "default": "spread", "range": false },
    "lines.*": { "default": "kw", "range": false },
    "note": { "default": "spread", "range": false }
  },
  "duration": { "min": 3, "max": 10 }
}
