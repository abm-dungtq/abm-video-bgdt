{
  "id": "notify-stack",
  "family": "notify-stack",
  "variants": ["cascade", "split"],
  "signatures": ["cascade"],
  "zone": { "cascade": "screen-focus", "split": "split-40-60" },
  "slots": {
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
      "heading": { "type": "string", "maxLength": 40, "description": "what the pile of notifications is about; the left column of split, a strip above the stack in cascade" },
      "items": {
        "type": "array", "minItems": 2, "maxItems": 5,
        "description": "notifications in arrival order; each lands on its own reveal key",
        "items": {
          "type": "object", "required": ["icon", "title"], "additionalProperties": false,
          "properties": {
            "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "title": { "type": "string", "minLength": 1, "maxLength": 26 },
            "text": { "type": "string", "maxLength": 48 },
            "when": { "type": "string", "maxLength": 10 }
          }
        }
      }
    }
  },
  "reveals": {
    "heading": { "default": "spread", "range": false },
    "items.*": { "default": "kw", "range": false }
  },
  "duration": { "min": 2.5, "max": 10 }
}
