{
  "id": "flow-vertical",
  "family": "flow-vertical",
  "variants": ["stack", "rail"],
  "signatures": ["stack"],
  "zone": { "stack": "hero-center", "rail": "screen-focus" },
  "slots": {
    "type": "object",
    "required": ["steps"],
    "additionalProperties": false,
    "properties": {
      "steps": {
        "type": "array", "minItems": 3, "maxItems": 6,
        "description": "a top-down process, one step per item, in order",
        "items": {
          "type": "object", "required": ["icon", "label"], "additionalProperties": false,
          "properties": {
            "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "label": { "type": "string", "minLength": 1, "maxLength": 26 }
          }
        }
      }
    }
  },
  "reveals": {
    "steps.*": { "default": "kw", "range": false }
  },
  "duration": { "min": 3, "max": 10 }
}
