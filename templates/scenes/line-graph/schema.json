{
  "id": "line-graph",
  "family": "line-graph",
  "variants": ["draw", "area"],
  "signatures": ["area"],
  "zone": { "draw": "strip-top", "area": "screen-focus" },
  "slots": {
    "type": "object",
    "required": ["labels", "series"],
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string", "maxLength": 40 },
      "unit": { "type": "string", "maxLength": 14 },
      "labels": {
        "type": "array", "minItems": 3, "maxItems": 8,
        "items": { "type": "string", "minLength": 1, "maxLength": 10 }
      },
      "series": {
        "type": "array", "minItems": 1, "maxItems": 2,
        "items": {
          "type": "object", "required": ["name", "values"], "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 18 },
            "values": {
              "type": "array", "minItems": 3, "maxItems": 8,
              "items": { "type": "integer", "minimum": 0, "maximum": 999999 }
            }
          }
        }
      }
    }
  },
  "reveals": {
    "title": { "default": "spread", "range": false },
    "series.*": { "default": "kw", "range": false }
  },
  "duration": { "min": 2.5, "max": 10 }
}
