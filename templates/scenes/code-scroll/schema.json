{
  "id": "code-scroll",
  "family": "code-scroll",
  "variants": ["minimap", "reel"],
  "signatures": ["reel"],
  "zone": { "minimap": "screen-focus", "reel": "screen-focus" },
  "slots": {
    "type": "object",
    "required": ["file", "lines", "focus"],
    "additionalProperties": false,
    "properties": {
      "file": { "type": "string", "minLength": 1, "maxLength": 32 },
      "lines": {
        "type": "array", "minItems": 12, "maxItems": 40,
        "description": "a long stretch of real code, one string per line",
        "items": { "type": "string", "maxLength": 48 }
      },
      "focus": { "type": "integer", "minimum": 0, "maximum": 39, "description": "index of the key line the scroll stops on" },
      "note": { "type": "string", "maxLength": 48 }
    }
  },
  "reveals": {
    "focus": { "default": "kw", "range": false },
    "note": { "default": "spread", "range": false, "after": "focus" }
  },
  "duration": { "min": 3.5, "max": 10 }
}
