    "file": "tro-ly-ca-nhan/doc_tai_lieu_a.py",
    "lines": [
      "# tro_ly.py — trợ lý đọc tài liệu và trả lời",
      "import os, sys, json, time, logging, pathlib",
      "from xai_sdk import Client",
      "from xai_sdk.chat import user, system, assistant",
      "",
      "MODEL = \"grok-4-fast-reasoning\"  # mô hình",
      "TIMEOUT = 3600  # giây chờ tối đa mỗi yêu cầu",
      "LOG = logging.getLogger(\"tro-ly-ca-nhan\")",
      "",
      "def make_client() -> Client:",
      "    key = os.environ.get(\"XAI_API_KEY\", \"\")",
      "    if not key: sys.exit(\"Thiếu khóa API rồi\")",
      "    return Client(api_key=key, timeout=TIMEOUT)",
      "",
      "def load(path: str) -> str:",
      "    text = pathlib.Path(path).read_text(\"utf-8\")",
      "    LOG.info(\"Đã đọc %d ký tự\", len(text))",
      "    return text",
      "",
      "def ask(client: Client, question: str) -> str:",
      "    chat = client.chat.create(model=MODEL)",
      "    chat.append(system(\"Trả lời tiếng Việt\"))",
      "    chat.append(user(question))",
      "    t0 = time.monotonic()",
      "    reply = chat.sample()",
      "    LOG.info(\"%.1f giây\", time.monotonic() - t0)",
      "    return reply.content",
      "",
      "def summarize(client: Client, text: str) -> str:",
      "    prompt = f\"Tóm tắt thành năm ý: {text}\"",
      "    return ask(client, prompt)",
      "",
      "def save(result: str, path=\"tom_tat.json\"):",
      "    d = {\"tom_tat\": result, \"luc\": time.time()}",
      "    pathlib.Path(path).write_text(json.dumps(d))",
      "",
      "if __name__ == \"__main__\":",
      "    client = make_client()",
      "    res = summarize(client, load(sys.argv[1]))",
      "    save(res)  # lưu kết quả để người dùng xem"
    ],
    "focus": 39,
    "note": "Kết quả cuối cùng được lưu lại cho người dùng"
  }
}