{
  "id": "code-focus",
  "family": "code-focus",
  "variants": ["sweep", "lens"],
  "signatures": ["lens"],
  "zone": { "sweep": "hero-center", "lens": "split-60-40" },
  "slots": {
    "type": "object",
    "required": ["file", "lines", "focus"],
    "additionalProperties": false,
    "properties": {
      "file": { "type": "string", "minLength": 1, "maxLength": 32 },
      "lines": {
        "type": "array", "minItems": 2, "maxItems": 10,
        "description": "real code, one string per line",
        "items": { "type": "string", "maxLength": 48 }
      },
      "focus": { "type": "integer", "minimum": 0, "maximum": 9, "description": "index of the line to spotlight" },
      "note": { "type": "string", "maxLength": 48 }
    }
  },
  "reveals": {
    "focus": { "default": "kw", "range": false },
    "note": { "default": "spread", "range": false, "after": "focus" }
  },
  "duration": { "min": 3, "max": 10 }
}
