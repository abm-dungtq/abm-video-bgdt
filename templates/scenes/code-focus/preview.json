      "# Vòng lặp chính: lập kế hoạch rồi gọi công cụ",
      "def run(task, max_steps=12, timeout=30.0):",
      "    plan = llm.plan(task, lang='vi', depth=3)",
      "    for index, step in enumerate(plan.steps):",
      "        result = tools.call(step, timeout=30)",
      "        memory.save(step.name, result, ttl=3600)",
      "        if index >= max_steps: break  # dừng sớm",
      "    report = memory.summary(style='ngắn gọn')",
      "    notify(user, report, channel='telegram')",
      "    return report  # trả kết quả cho người dùng"
    ],
