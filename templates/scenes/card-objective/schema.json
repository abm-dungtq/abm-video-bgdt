{
  "id": "card-objective",
  "family": "objective",
  "card": "card-objective",
  "variants": ["list", "spotlight", "target-rings"],
  "signatures": ["list"],
  "zone": { "list": "split-40-60", "spotlight": "triptych", "target-rings": "split-40-60" },
  "slots": {
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array", "minItems": 1, "maxItems": 3,
        "items": { "type": "string", "minLength": 1, "maxLength": 48 }
      }
    }
  },
  "reveals": {
    "label": { "default": "spread", "range": false },
    "items.*": { "default": "kw", "range": false }
  },
  "duration": { "min": 4, "max": 10 }
}
