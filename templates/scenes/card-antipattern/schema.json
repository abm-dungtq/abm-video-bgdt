{
  "id": "card-antipattern",
  "family": "antipattern",
  "card": "card-antipattern",
  "variants": ["side-by-side", "flip", "strike"],
  "directorOnly": ["strike"],
  "signatures": ["flip"],
  "zone": { "side-by-side": "split-50", "flip": "hero-center", "strike": "strip-top" },
  "slots": {
    "type": "object",
    "required": ["wrong", "right"],
    "additionalProperties": false,
    "properties": {
      "wrong": {
        "type": "object", "required": ["label", "items"], "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 20 },
          "items": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 40 } }
        }
      },
      "right": {
        "type": "object", "required": ["label", "items"], "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 20 },
          "items": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 40 } }
        }
      }
    }
  },
  "reveals": {
    "label": { "default": "spread", "range": false },
    "wrong": { "default": "kw", "range": false, "transient": true },
    "right": { "default": "kw", "range": false, "after": "wrong" }
  },
  "duration": { "min": 4, "max": 10 }
}
